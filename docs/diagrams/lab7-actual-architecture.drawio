  <diagram id="model-relations" name="Зв'язки моделей">
    <mxGraphModel dx="1900" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1400" background="#F8FAFC" math="0" shadow="0">
      <root>
        <mxCell id="r0"/>
        <mxCell id="r1" parent="r0"/>
        <mxCell id="rtitle" value="iPhoneHub — зв'язки Eloquent та кратності" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontFamily=Helvetica;fontSize=30;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="r1"><mxGeometry x="60" y="35" width="1800" height="45" as="geometry"/></mxCell>
        <mxCell id="rsubtitle" value="Фактична модель лабораторних робіт №6–7; усі зв'язки реалізовані методами моделей та зовнішніми ключами" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontFamily=Helvetica;fontSize=17;fontColor=#52667A;" vertex="1" parent="r1"><mxGeometry x="60" y="85" width="1800" height="30" as="geometry"/></mxCell>

        <mxCell id="User" value="&lt;b&gt;User&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52667A&quot;&gt;id · name · email · role · active&lt;/font&gt;&lt;br&gt;+ cart(): HasOne&lt;br&gt;+ orders(): HasMany" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4A6FA5;strokeWidth=2;fontSize=16;fontColor=#172B4D;spacing=12;" vertex="1" parent="r1"><mxGeometry x="100" y="180" width="330" height="145" as="geometry"/></mxCell>
        <mxCell id="Cart" value="&lt;b&gt;Cart&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52667A&quot;&gt;id · user_id · status&lt;/font&gt;&lt;br&gt;+ user(): BelongsTo&lt;br&gt;+ items(): HasMany" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7F0;strokeColor=#37835B;strokeWidth=2;fontSize=16;fontColor=#173C2A;spacing=12;" vertex="1" parent="r1"><mxGeometry x="100" y="480" width="330" height="145" as="geometry"/></mxCell>
        <mxCell id="CartItem" value="&lt;b&gt;CartItem&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52667A&quot;&gt;cart_id · product_id · quantity&lt;/font&gt;&lt;br&gt;+ cart(): BelongsTo&lt;br&gt;+ product(): BelongsTo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3FBF6;strokeColor=#72AD8D;strokeWidth=2;fontSize=16;fontColor=#173C2A;spacing=12;" vertex="1" parent="r1"><mxGeometry x="100" y="800" width="330" height="145" as="geometry"/></mxCell>

        <mxCell id="Order" value="&lt;b&gt;Order&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52667A&quot;&gt;user_id · status · total_kop · checkout_key&lt;/font&gt;&lt;br&gt;+ user(): BelongsTo · items(): HasMany&lt;br&gt;+ shipment(): HasOne" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#C99820;strokeWidth=2;fontSize=16;fontColor=#5B4815;spacing=12;" vertex="1" parent="r1"><mxGeometry x="610" y="180" width="390" height="155" as="geometry"/></mxCell>
        <mxCell id="OrderItem" value="&lt;b&gt;OrderItem&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52667A&quot;&gt;order_id · product_id? · product_name&lt;br&gt;sku · quantity · unit_price_kop&lt;/font&gt;&lt;br&gt;+ order(): BelongsTo · product(): BelongsTo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9EA;strokeColor=#D7B34F;strokeWidth=2;fontSize=16;fontColor=#5B4815;spacing=12;" vertex="1" parent="r1"><mxGeometry x="610" y="530" width="390" height="175" as="geometry"/></mxCell>
        <mxCell id="Shipment" value="&lt;b&gt;Shipment&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52667A&quot;&gt;order_id · tracking_number · status&lt;br&gt;recipient · address · delivered_at&lt;/font&gt;&lt;br&gt;+ order(): BelongsTo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F0;strokeColor=#C85C5A;strokeWidth=2;fontSize=16;fontColor=#6B2726;spacing=12;" vertex="1" parent="r1"><mxGeometry x="610" y="870" width="390" height="165" as="geometry"/></mxCell>

        <mxCell id="Product" value="&lt;b&gt;Product&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52667A&quot;&gt;category_id? · model_name · sku · price_kop&lt;br&gt;stock_qty · reserved_qty · active&lt;/font&gt;&lt;br&gt;+ category() · tags() · cartItems() · orderItems()&lt;br&gt;+ availableQty(): int" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF4FB;strokeColor=#3E7498;strokeWidth=2;fontSize=16;fontColor=#193A51;spacing=12;" vertex="1" parent="r1"><mxGeometry x="1160" y="530" width="430" height="190" as="geometry"/></mxCell>
        <mxCell id="Category" value="&lt;b&gt;Category&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52667A&quot;&gt;id · name · slug · active&lt;/font&gt;&lt;br&gt;+ products(): HasMany" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0ECFF;strokeColor=#7657B5;strokeWidth=2;fontSize=16;fontColor=#35265A;spacing=12;" vertex="1" parent="r1"><mxGeometry x="1450" y="180" width="330" height="135" as="geometry"/></mxCell>
        <mxCell id="Tag" value="&lt;b&gt;Tag&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52667A&quot;&gt;id · name · slug&lt;/font&gt;&lt;br&gt;+ products(): BelongsToMany" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0ECFF;strokeColor=#7657B5;strokeWidth=2;fontSize=16;fontColor=#35265A;spacing=12;" vertex="1" parent="r1"><mxGeometry x="1450" y="890" width="330" height="135" as="geometry"/></mxCell>
        <mxCell id="pivot" value="&lt;b&gt;product_tag&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52667A&quot;&gt;UNIQUE(product_id, tag_id)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF8FF;strokeColor=#A695CF;dashed=1;fontSize=15;fontColor=#35265A;spacing=10;" vertex="1" parent="r1"><mxGeometry x="1200" y="920" width="220" height="85" as="geometry"/></mxCell>

        <mxCell id="note1" value="&lt;b&gt;Композиція&lt;/b&gt;&lt;br&gt;CartItem видаляється разом із Cart;&lt;br&gt;OrderItem — разом із Order." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFFFFF;strokeColor=#9AA9B8;fontSize=14;fontColor=#52667A;spacing=10;" vertex="1" parent="r1"><mxGeometry x="90" y="1110" width="400" height="120" as="geometry"/></mxCell>
        <mxCell id="note2" value="&lt;b&gt;Історичний знімок&lt;/b&gt;&lt;br&gt;OrderItem зберігає назву, SKU та ціну навіть після зміни або видалення Product." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFFFFF;strokeColor=#9AA9B8;fontSize=14;fontColor=#52667A;spacing=10;" vertex="1" parent="r1"><mxGeometry x="610" y="1110" width="500" height="120" as="geometry"/></mxCell>
        <mxCell id="note3" value="&lt;b&gt;Необов'язкова категорія&lt;/b&gt;&lt;br&gt;Після видалення Category поле products.category_id стає NULL; товар зберігається." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFFFFF;strokeColor=#9AA9B8;fontSize=14;fontColor=#52667A;spacing=10;" vertex="1" parent="r1"><mxGeometry x="1260" y="1110" width="520" height="120" as="geometry"/></mxCell>

        <mxCell id="ru1" value="1     0..1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=none;endArrow=none;strokeColor=#4A6FA5;strokeWidth=2;fontSize=14;" edge="1" parent="r1" source="User" target="Cart"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ru2" value="1     0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=none;endArrow=none;strokeColor=#8A742D;strokeWidth=2;fontSize=14;" edge="1" parent="r1" source="User" target="Order"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rc1" value="1     0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=diamond;startFill=1;endArrow=none;strokeColor=#37835B;strokeWidth=2;fontSize=14;" edge="1" parent="r1" source="Cart" target="CartItem"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ro1" value="1     1..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=diamond;startFill=1;endArrow=none;strokeColor=#C99820;strokeWidth=2;fontSize=14;" edge="1" parent="r1" source="Order" target="OrderItem"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rs1" value="1     0..1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=none;endArrow=none;strokeColor=#C85C5A;strokeWidth=2;fontSize=14;" edge="1" parent="r1" source="Order" target="Shipment"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1050" y="260"/><mxPoint x="1050" y="950"/></Array></mxGeometry></mxCell>
